# ─────────────────────────────────────────────────────────────
# OBLIGATORIAS — sin esto el panel no arranca
# ─────────────────────────────────────────────────────────────

# Base de datos Postgres de Neon (neon.tech → tu proyecto → Connection string).
DATABASE_URL=

# Contraseña para entrar a tu panel interno.
APP_PASSWORD=

# Secreto para firmar sesiones. Generalo con:  openssl rand -hex 32
SESSION_SECRET=

# Clave para cifrar tokens y accesos de clientes (64 caracteres hex).
# Generala con:  openssl rand -hex 32
# ¡No la cambies después de cargar datos o no vas a poder leerlos!
ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────
# TU MARCA
# ─────────────────────────────────────────────────────────────

# Nombre de tu agencia: aparece en el panel y en el portal de clientes.
NEXT_PUBLIC_AGENCY_NAME=Mi Agencia
# Tu nombre de pila, para el saludo del dashboard.
NEXT_PUBLIC_OWNER_NAME=
# URL pública del panel, sin barra final (ej: https://panel.miagencia.com).
NEXT_PUBLIC_APP_URL=
# Mail de contacto que aparece en /privacidad y /terminos.
LEGAL_CONTACT_EMAIL=

# ─────────────────────────────────────────────────────────────
# OPCIONALES — cada módulo se activa cuando cargás sus claves
# ─────────────────────────────────────────────────────────────

# Formulario de tu web → Leads. Dominios que pueden enviar el formulario
# (separados por coma) y clave de Web3Forms para que te llegue el mail.
LEADS_ALLOWED_ORIGINS=
WEB3FORMS_ACCESS_KEY=

# Google Analytics (estadísticas de tu web y las de tus clientes) y
# Google Calendar (agenda del día en el dashboard). Cuenta de servicio de Google Cloud.
GA_SERVICE_ACCOUNT_EMAIL=
GA_SERVICE_ACCOUNT_PRIVATE_KEY=
# IDs de calendarios a mostrar (normalmente tu mail), separados por coma.
# Compartí cada calendario con GA_SERVICE_ACCOUNT_EMAIL.
GOOGLE_CALENDAR_IDS=

# Contenido · IA: ideas y guiones de reels (console.anthropic.com).
ANTHROPIC_API_KEY=
# Contenido · transcripción de videos (console.groq.com).
GROQ_API_KEY=

# Contenido · Instagram (app de Meta con "Instagram API with Instagram Login").
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Opcional: por defecto usa <tu-dominio>/api/instagram/callback
INSTAGRAM_REDIRECT_URI=

# Contenido · Inspiración (app de Meta con "Facebook Login for Business").
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
# Opcional: por defecto usa <tu-dominio>/api/facebook/callback
META_REDIRECT_URI=

# Contenido · TikTok (developers.tiktok.com, Login Kit + Display API).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Opcional: por defecto usa <tu-dominio>/api/tiktok/callback
TIKTOK_REDIRECT_URI=
